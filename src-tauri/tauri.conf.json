{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bateleur",
  "version": "0.27.4",
  "identifier": "com.bateleur.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bateleur",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Kipkirui",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Kipkirui",
    "shortDescription": "Local-first magazine mail client",
    "longDescription": "A local-first desktop mail client. Magazine feed, any IMAP or POP mailbox, optional BYOK staff.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNEQwOTY3ODVGQTMxMDkKUldRSk1mcUZad2xOd0pyeHpvd2poMmNqN2xwdnJVU3AyRVpoQzdwOFpXVlZLUFcwaWVjVjRoMjkK",
      "endpoints": [
        "https://github.com/kipkirui/Bateleur/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
